{
  "expo": {
    "name": "Bethel Ministries",
    "slug": "bethel-ministries",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEF6FF"
    },
    "android": {
      "package": "com.bethelministries.app",
      "adaptiveIcon": {
        "backgroundColor": "#EEF6FF"
      }
    },
    "ios": {
      "bundleIdentifier": "com.bethelministries.app"
    },
    "plugins": ["expo-notifications"],
    "extra": {
      "firebaseApiKey": "YOUR_API_KEY",
      "firebaseAuthDomain": "YOUR_AUTH_DOMAIN",
      "firebaseProjectId": "YOUR_PROJECT_ID",
      "firebaseStorageBucket": "YOUR_STORAGE_BUCKET",
      "firebaseMessagingSenderId": "YOUR_MESSAGING_SENDER_ID",
      "firebaseAppId": "YOUR_APP_ID"
    }
  }
}
